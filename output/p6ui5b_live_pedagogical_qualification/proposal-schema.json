          "title": "Learning Spec Hash",
          "type": "string"
        },
        "policy_version": {
          "const": "bounded-symbol-evidence-authoring/1",
          "default": "bounded-symbol-evidence-authoring/1",
          "title": "Policy Version",
          "type": "string"
        },
        "prohibited_claims": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Claims",
          "type": "array"
        },
        "review_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Review Requirements",
          "type": "array"
        },
        "role_evidence_hash": {
          "title": "Role Evidence Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "pedagogical-evidence-authoring-brief/1",
          "default": "pedagogical-evidence-authoring-brief/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_learning_spec": {
          "$ref": "#/$defs/GovernedLearningSpecification"
        }
      },
      "required": [
        "learning_spec_hash",
        "source_learning_spec",
        "allowed_categories",
        "role_evidence_hash",
        "prohibited_claims",
        "authoring_constraints",
        "review_requirements"
      ],
      "title": "Brief",
      "type": "object"
    },
    "CanonicalSemantic": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "title": "Canonical Id",
          "type": "string"
