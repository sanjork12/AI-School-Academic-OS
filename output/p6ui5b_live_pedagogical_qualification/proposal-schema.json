          "const": false,
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "pedagogical-adapter/1",
          "default": "pedagogical-adapter/1",
          "title": "Schema Version",
          "type": "string"
