{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "pattern": "^ACT-[1-9][0-9]*$",
          "title": "Activity Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "REPRESENTATION",
            "CONCEPT_CHECK"
          ],
          "title": "Category",
          "type": "string"
        },
        "criterion_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Criterion Ids",
          "type": "array"
        },
        "evidence_basis": {
          "$ref": "#/$defs/Basis"
        },
        "response_mode": {
          "enum": [
            "SYMBOL_SELECTION",
            "SYMBOL_INTERPRETATION"
          ],
          "title": "Response Mode",
          "type": "string"
        },
        "scope": {
          "const": "REVIEWED_INEQUALITY_SYMBOLS_ONLY",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "activity_id",
        "category",
        "criterion_ids",
        "response_mode",
        "scope",
        "evidence_basis"
      ],
      "title": "Activity",
      "type": "object"
    },
    "Adapter": {
