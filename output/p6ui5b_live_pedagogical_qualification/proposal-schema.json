            "type": "string"
          },
          "minItems": 1,
          "title": "Candidate Role Families",
          "type": "array"
        },
        "canonical_id": {
          "title": "Canonical Id",
          "type": "string"
        },
        "check_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Check Ids",
          "type": "array"
        },
        "criterion_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Criterion Ids",
          "type": "array"
        },
        "evidence_basis": {
          "$ref": "#/$defs/Basis"
